{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "base/organization: one organization (applications/<org>/organization.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization",
    "forgejo",
    "keycloak",
    "owners"
  ],
  "properties": {
    "organization": {
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,28}[a-z0-9])?$",
      "description": "the organization's directory name"
    },
    "forgejo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "visibility"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "limited",
            "private"
          ]
        }
      }
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realm"
      ],
      "properties": {
        "realm": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
