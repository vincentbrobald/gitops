{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "base/team: one team (applications/<org>/<team>/team.yaml and the ApplicationSet team-platform)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "team",
    "description",
    "members",
    "repositories",
    "organization",
    "realm",
    "component",
    "cluster",
    "appsDomain"
  ],
  "properties": {
    "team": {
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$",
      "description": "the team's directory name"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Keycloak user names (= Forgejo user names)"
    },
    "repositories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9._-]{0,98}[a-z0-9])?$"
      },
      "description": "besides <team>-gitops, each <team>-... (the prefix is checked by the template)"
    },
    "removed": {
      "type": "boolean",
      "description": "Step 1 of removing the team: its Applications go, its folder stays until step 2 (docs/how-to/remove-a-team-or-environment.md)."
    },
    "organization": {
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,28}[a-z0-9])?$"
    },
    "realm": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "enum": [
        "core",
        "ci",
        "packages"
      ]
    },
    "cluster": {
      "type": "string",
      "minLength": 1
    },
    "appsDomain": {
      "type": "string",
      "minLength": 1
    },
    "repoBase": {
      "type": "string",
      "minLength": 1
    },
    "forgejoURL": {
      "type": "string",
      "minLength": 1
    },
    "keycloakURL": {
      "type": "string",
      "minLength": 1
    },
    "quota": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "harbor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageQuotaGB": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quota": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "tektonDashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "image",
        "oauth2ProxyImage"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "oauth2ProxyImage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifactKeeper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format"
            ],
            "properties": {
              "format": {
                "type": "string",
                "minLength": 1
              },
              "cache": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
